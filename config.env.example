# Copy to config.env (gitignored). Named config.env, not .env, because Flutter 3.50 drops
# dotfile assets on Android (flutter/flutter#196444); switch back to .env once that is fixed.
# Jadewell Flutter app environment. Gitignored. SHIPS INSIDE THE APP as an asset,
# so only public values belong here (client ids, public URLs). Never secrets.

# OAuth 2.0 WEB client id from Firebase project jadewell-c6647
# (Google Cloud Console → APIs & Services → Credentials → "Web client").
GOOGLE_WEB_CLIENT_ID=

# Debug/profile builds use DEV, release builds use PROD.
# DEV must be reachable from the phone: use this PC's LAN IP, not localhost.
DEV_API_BACKEND_URL=http://<your-lan-ip>:8393/api/v1
PROD_API_BACKEND_URL=https://jadewell.pranta.dev/api/v1
